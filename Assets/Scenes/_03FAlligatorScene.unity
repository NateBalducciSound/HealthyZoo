  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1ab18b11fc007447180abcb24ce727d3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueController
  audioSource: {fileID: 221412550}
  captionBox: {fileID: 435422276}
  captionLingerTime: 1
  spanishFont: {fileID: 11400000, guid: ec752da0268ee4eb48f9eab01ba26e37, type: 2}
  openingLine:
    english: {fileID: 8300000, guid: 0066efd9bbd15409d9ff9cb1831070a6, type: 3}
    spanish: {fileID: 8300000, guid: 7f9d3241542a04a119d38aff56a6272c, type: 3}
  openingCaption:
    english: Let's find a way to see if Arlo might have a sore throat. To get him
      to say "ahhhhh" drag the tongue depressor and touch his face. Be sure to touch
      him gently.
    spanish: "Busquemos la manera de ver si Arlo podr\xEDa tener dolor de garganta.
      Para lograr que diga \"ahhhhhh\", desliza el bajalenguas y t\xF3calo en la
      cara. Aseg\xFArate de tocarlo con suavidad."
  completionLine:
    english: {fileID: 8300000, guid: 86d791669cdc042ccb4c140dcd8977d2, type: 3}
    spanish: {fileID: 8300000, guid: 28e0b512114674ab8b3cf33e3753dff6, type: 3}
  completionCaption:
    english: Arlo's throat looks good! Baby alligators make cute chirping sounds
      before they hatch from their eggs, then they use their tails to swim super
      fast in the water!
    spanish: "\xA1La garganta de Arlo se ve bien! Los caimanes beb\xE9s emiten lindos
      sonidos de cantito de pajaros antes de salir de sus huevos; \xA1luego usan
      sus colas para nadar s\xFAper r\xE1pido en el agua!"
  nudgeOnFixedTimer: 0
  nudgeDelay: 5
  nudgeInterval: 6
  nudgeLines:
  - english: {fileID: 8300000, guid: 0c1b5038b697d4718815ccc37dbb681c, type: 3}
    spanish: {fileID: 8300000, guid: 07cf9860aa8ca4faa8c539b52702616a, type: 3}
  - english: {fileID: 8300000, guid: cb205dbe144334df7afe7f783016d132, type: 3}
    spanish: {fileID: 8300000, guid: a0f21e8beadb440d1ada96aa48adc925, type: 3}
  nudgeCaptions:
  - english: The tongue depressor is the flat wooden stick up above Arlo's head.
      Drag it down and touch the area near his nose to see if he reacts.
    spanish: "El bajalenguas es el palito de madera plano que se encuentra sobre
      la cabeza de Arlo. Arr\xE1stralo hacia abajo y toca la zona cercana a su nariz
      para ver si reacciona."
  - english: Alligators like to open their mouth when you touch their nose.
    spanish: A los caimanes les gusta abrir la boca cuando les tocas la nariz.
